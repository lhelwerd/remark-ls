{
  "name": "@lhelwerda/remark-ls",
  "version": "0.1.0",
  "type": "module",
  "description": "Wrapper of remark-language-server to apply shared Markdown conventions everywhere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhelwerd/remark-ls.git"
  },
  "bugs": "https://github.com/lhelwerd/remark-ls/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Leon Helwerda <leon.helwerda@gmail.com>",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-reporter=tap --test-reporter=junit --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=junit.xml --test-reporter-destination=lcov.info tests/*.test.mjs"
  },
  "bin": {
    "remark-ls": "bin/index.mjs"
  },
  "files": [
    "bin/index.mjs",
    "lib/*.mjs",
    "plugins/*.mjs",
    ".remarkrc.mjs"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "unified-language-server": "^4.1.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.9"
  }
}
