{
  "name": "@lhelwerda/remark-ls",
  "version": "0.2.0",
  "type": "module",
  "description": "Wrapper of remark-language-server to apply shared Markdown conventions everywhere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhelwerd/remark-ls.git"
  },
  "bugs": "https://github.com/lhelwerd/remark-ls/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Leon Helwerda <leon.helwerda@gmail.com>",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-reporter=tap --test-reporter=junit --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=junit$RUN_ID.xml --test-reporter-destination=lcov$RUN_ID.info tests/*.test.mjs"
  },
  "bin": {
    "remark-ls": "bin/index.mjs"
  },
  "files": [
    "bin/index.mjs",
    "lib/*.mjs",
    "plugins/*.mjs",
    ".remarkrc.mjs"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "unified-language-server": "^4.1.0",
    "unist-util-visit": "^5.2.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.6",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "release-it": "^21.1.2"
  }
}
