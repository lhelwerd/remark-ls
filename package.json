{
  "name": "@lhelwerda/remark-ls",
  "version": "0.0.1",
  "type": "module",
  "description": "Wrapper of remark-language-server to apply shared Markdown conventions everywhere",
  "repository": "https://github.com/lhelwerd/remark-ls",
  "bugs": "https://github.com/lhelwerd/remark-ls/issues",
  "license": "MIT",
  "author": "Leon Helwerda <leon.helwerda@gmail.com>",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-reporter=tap --test-reporter=junit --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=junit.xml --test-reporter-destination=lcov.info tests/*.test.mjs"
  },
  "bin": {
      "remark-ls": "bin/index.mjs"
  },
  "files": [
    "bin/index.mjs",
    "lib/*.mjs",
    "plugins/*.mjs",
    ".remarkrc.mjs"
  ],
  "dependencies": {
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "unified-language-server": "^4.1.0"
  }
}
